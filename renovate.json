{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "automergeStrategy": "rebase",
    "automergeType": "pr",
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                "/.*container_build_args\\.conf$/"
            ],
            "matchStrings": [
                "(?<depName>[\\w\\-\\.\\/]+):?(?<currentValue>[\\w\\-\\.]+)?@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                "/^\\.konflux/overlay/pin_images\\.in\\.yaml$/"
            ],
            "matchStrings": [
                "(?<depName>registry\\.redhat\\.io/openshift4/ose-kube-rbac-proxy-rhel9):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                "/^\\.konflux/overlay/pin_images\\.in\\.yaml$/"
            ],
            "matchStrings": [
                "(?<depName>registry\\.redhat\\.io/openshift4/ose-kube-rbac-proxy-rhel8):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "versioningTemplate": "docker"
        }
    ],
    "git-submodules": {
        "enabled": true,
        "packageRules": [
            {
                "addLabels": [
                    "allow-automatic-merge"
                ],
                "additionalBranchPrefix": "telco5g-konflux-",
                "matchPackageNames": [
                    "https://github.com/openshift-kni/telco5g-konflux.git"
                ],
                "schedule": [
                    "at any time"
                ]
            }
        ]
    },
    "gomod": {
        "enabled": true,
        "postUpdateOptions": [
            "gomodUpdateImportPaths",
            "gomodTidy"
        ],
        "packageRules": [
            {
                "matchManagers": [
                    "gomod"
                ],
                "matchDepTypes": [
                    "indirect"
                ],
                "enabled": false
            }
        ]
    },
    "packageRules": [
        {
            "addLabels": [
                "allow-automatic-merge"
            ],
            "enabled": true,
            "ignoreTests": false,
            "includePaths": [
                ".konflux/**"
            ],
            "matchManagers": [
                "custom.regex"
            ],
            "matchUpdateTypes": [
                "digest"
            ],
            "schedule": [
                "at any time"
            ]
        },
        {
            "enabled": false,
            "matchUpdateTypes": [
                "minor"
            ]
        },
        {
            "description": "Migrated from Dependabot: enable Go module updates and auto-merge digest/patch/minor once CI passes. Also re-enables minor for gomod, overriding the global minor disable above. Major updates are left as normal PRs for manual review.",
            "matchManagers": [
                "gomod"
            ],
            "matchUpdateTypes": [
                "digest",
                "patch",
                "minor"
            ],
            "enabled": true,
            "ignoreTests": false,
            "addLabels": [
                "allow-automatic-merge"
            ]
        },
        {
            "description": "Group the Kubernetes ecosystem into a single PR.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "k8s.io/**",
                "sigs.k8s.io/**"
            ],
            "groupName": "kubernetes"
        },
        {
            "description": "Group golang.org/x updates.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "golang.org/x/**"
            ],
            "groupName": "golang.org/x"
        },
        {
            "description": "Group open-cluster-management.io updates.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "open-cluster-management.io/**"
            ],
            "groupName": "ocm"
        },
        {
            "description": "Group ginkgo and gomega together.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/onsi/ginkgo/v2",
                "github.com/onsi/gomega"
            ],
            "groupName": "ginkgo"
        },
        {
            "description": "Skip noisy onsi patch bumps (matches previous Dependabot policy).",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/onsi/**"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "enabled": false
        },
        {
            "description": "Only allow patch updates for the Go toolchain directive on release branches. Prevents minor/major bumps (e.g. go1.22.4 → go1.27.1) while still allowing security patches (e.g. go1.22.4 → go1.22.9).",
            "matchManagers": ["gomod"],
            "matchDepTypes": ["toolchain"],
            "matchUpdateTypes": ["minor", "major"],
            "matchBaseBranches": ["/^release-/"],
            "enabled": false
        },
        {
            "description": "Only propose Go module updates compatible with each branch's existing go directive. Renovate never bumps the go directive itself (its default), and this skips dependency updates whose new version would require a newer Go than the branch targets. Since the config is read from the default branch but the go directive is read per branch, release branches (e.g. go 1.24) are protected from updates that need a newer toolchain, while main follows its own go version.",
            "matchManagers": [
                "gomod"
            ],
            "constraintsFiltering": "strict"
        },
        {
            "description": "Disable gomod updates on all release branches by default. New release branches are excluded automatically until explicitly added to the re-enable rule below.",
            "matchManagers": ["gomod"],
            "matchBaseBranches": ["/^release-/"],
            "enabled": false
        },
        {
            "description": "Re-enable gomod updates on actively maintained release branches only.",
            "matchManagers": ["gomod"],
            "matchBaseBranches": ["release-5.0", "release-4.22"],
            "enabled": true
        }
    ],
    "prConcurrentLimit": 0,
    "pruneBranchAfterAutomerge": true,
    "tekton": {
        "addLabels": [
            "allow-automatic-merge"
        ],
        "enabled": true,
        "ignoreTests": false,
        "includePaths": [
            ".tekton/**"
        ],
        "managerFilePatterns": [
            "/\\.yaml$/",
            "/\\.yml$/"
        ]
    }
}
