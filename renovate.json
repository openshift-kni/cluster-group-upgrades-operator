{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "automergeStrategy": "rebase",
    "automergeType": "pr",
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                "/.*container_build_args\\.conf$/"
            ],
            "matchStrings": [
                "(?<depName>[\\w\\-\\.\\/]+):?(?<currentValue>[\\w\\-\\.]+)?@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                "/^\\.konflux/overlay/pin_images\\.in\\.yaml$/"
            ],
            "matchStrings": [
                "(?<depName>registry\\.redhat\\.io/openshift4/ose-kube-rbac-proxy-rhel9):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                "/^\\.konflux/overlay/pin_images\\.in\\.yaml$/"
            ],
            "matchStrings": [
                "(?<depName>registry\\.redhat\\.io/openshift4/ose-kube-rbac-proxy-rhel8):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "versioningTemplate": "docker"
        }
    ],
    "git-submodules": {
        "enabled": true,
        "packageRules": [
            {
                "addLabels": [
                    "allow-automatic-merge"
                ],
                "additionalBranchPrefix": "telco5g-konflux-",
                "matchPackageNames": [
                    "https://github.com/openshift-kni/telco5g-konflux.git"
                ],
                "schedule": [
                    "at any time"
                ]
            }
        ]
    },
    "gomod": {
        "enabled": true
    },
    "packageRules": [
        {
            "addLabels": [
                "allow-automatic-merge"
            ],
            "enabled": true,
            "ignoreTests": false,
            "includePaths": [
                ".konflux/**"
            ],
            "matchManagers": [
                "custom.regex"
            ],
            "matchUpdateTypes": [
                "digest"
            ],
            "schedule": [
                "at any time"
            ]
        },
        {
            "enabled": false,
            "matchUpdateTypes": [
                "minor"
            ]
        },
        {
            "description": "Migrated from Dependabot: enable Go module updates and auto-merge digest/patch/minor once CI passes. Also re-enables minor for gomod, overriding the global minor disable above. Major updates are left as normal PRs for manual review.",
            "matchManagers": [
                "gomod"
            ],
            "matchUpdateTypes": [
                "digest",
                "patch",
                "minor"
            ],
            "enabled": true,
            "ignoreTests": false,
            "addLabels": [
                "allow-automatic-merge"
            ]
        },
        {
            "description": "Group the Kubernetes ecosystem into a single PR.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "k8s.io/**",
                "sigs.k8s.io/**"
            ],
            "groupName": "kubernetes"
        },
        {
            "description": "Group golang.org/x updates.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "golang.org/x/**"
            ],
            "groupName": "golang.org/x"
        },
        {
            "description": "Group open-cluster-management.io updates.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "open-cluster-management.io/**"
            ],
            "groupName": "ocm"
        },
        {
            "description": "Group ginkgo and gomega together.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/onsi/ginkgo/v2",
                "github.com/onsi/gomega"
            ],
            "groupName": "ginkgo"
        },
        {
            "description": "Skip noisy onsi patch bumps (matches previous Dependabot policy).",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/onsi/**"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "enabled": false
        }
    ],
    "prConcurrentLimit": 0,
    "pruneBranchAfterAutomerge": true,
    "tekton": {
        "addLabels": [
            "allow-automatic-merge"
        ],
        "enabled": true,
        "ignoreTests": false,
        "includePaths": [
            ".tekton/**"
        ],
        "managerFilePatterns": [
            "/\\.yaml$/",
            "/\\.yml$/"
        ]
    }
}
